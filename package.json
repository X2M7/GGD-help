{
  "name": "ggd-help",
  "productName": "GGD-help",
  "version": "0.2.1",
  "description": "鹅鸭杀透明会议蒙版：身份、死亡记录和分辨率校准",
  "main": "index.js",
  "scripts": {
    "start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-native.ps1 -Build",
    "check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-native.ps1",
    "test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-native-models.ps1",
    "test:components": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-native-components.ps1",
    "test:smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-native.ps1",
    "test:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-native.ps1",
    "package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-native.ps1",
    "dist": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-native.ps1",
    "start:electron": "electron .",
    "check:electron": "node --check index.js && node --check preload.js && node --check renderer.js && node --check core.js && node --check launcher.js",
    "test:electron": "node --test tests/*.test.js",
    "test:smoke:electron": "node tests/electron.smoke.cjs",
    "test:release:electron": "node tests/release.smoke.cjs",
    "fixtures:electron": "node scripts/make-native-fixtures.cjs",
    "package:electron": "node scripts/package.cjs",
    "dist:electron": "node scripts/dist.cjs"
  },
  "keywords": [],
  "author": "dawdfagyfd",
  "license": "ISC",
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "playwright": "1.64.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/X2M7/GGD-help.git"
  },
  "build": {
    "appId": "net.xumin.ggd-help",
    "productName": "GGD-help",
    "copyright": "Based on snapea/goose-duck-help",
    "directories": {
      "output": "release/electron"
    },
    "files": [
      "index.js",
      "preload.js",
      "core.js",
      "shell-state.js",
      "legacy-data.js",
      "renderer.js",
      "index.html",
      "style.css",
      "launcher.html",
      "launcher.js",
      "launcher.css",
      "README.md"
    ],
    "asar": true,
    "electronLanguages": ["zh-CN", "zh-TW", "en-US"],
    "publish": null,
    "win": {
      "target": [{ "target": "portable", "arch": ["x64"] }],
      "executableName": "GGD-help",
      "signExecutable": false,
      "artifactName": "GGD-help-Electron-V${version}-win-${arch}.${ext}"
    },
    "portable": {
      "requestExecutionLevel": "user"
    }
  }
}
