{
  "name": "ggd-help",
  "productName": "GGD-help",
  "version": "0.1.1",
  "description": "鹅鸭杀透明会议蒙版：身份、死亡记录和分辨率校准",
  "main": "index.js",
  "scripts": {
    "start": "electron .",
    "check": "node --check index.js && node --check preload.js && node --check renderer.js && node --check core.js && node --check launcher.js",
    "test": "node --test tests/*.test.js",
    "test:smoke": "node tests/electron.smoke.cjs",
    "test:release": "node tests/release.smoke.cjs",
    "package": "node scripts/package.cjs",
    "dist": "node scripts/dist.cjs"
  },
  "keywords": [],
  "author": "dawdfagyfd",
  "license": "ISC",
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "playwright": "1.64.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/X2M7/GGD-help.git"
  },
  "build": {
    "appId": "net.xumin.ggd-help",
    "productName": "GGD-help",
    "copyright": "Based on snapea/goose-duck-help",
    "directories": {
      "output": "release"
    },
    "files": [
      "index.js",
      "preload.js",
      "core.js",
      "shell-state.js",
      "legacy-data.js",
      "renderer.js",
      "index.html",
      "style.css",
      "launcher.html",
      "launcher.js",
      "launcher.css",
      "README.md"
    ],
    "asar": true,
    "publish": null,
    "win": {
      "target": [{ "target": "portable", "arch": ["x64"] }],
      "executableName": "GGD-help",
      "signExecutable": false,
      "artifactName": "GGD-help-V${version}-win-${arch}.${ext}"
    },
    "portable": {
      "requestExecutionLevel": "user"
    }
  }
}
